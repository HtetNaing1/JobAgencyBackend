NODE_ENV=development

# Port the API listens on.
# Avoid 5000 on macOS, it is used by the AirPlay Receiver service.
PORT=5001

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/job-agency?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=24h

# Frontend URL, used as the allowed CORS origin
FRONTEND_URL=http://localhost:3000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration
# Option 1: SendGrid (https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=
# Option 2: Brevo (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=

# Sender identity. The address must be verified with your email provider.
EMAIL_FROM_ADDRESS=noreply@jobagency.com
EMAIL_FROM_NAME=JobAgency

# Set to true to block login until the user has verified their email address.
REQUIRE_EMAIL_VERIFICATION=false
